# ===================================================
# ESPN Configuration
# ===================================================
# ESPN cookie credentials
ESPN_S2=your_espn_s2_cookie_here
ESPN_SWID={YOUR-SWID-COOKIE-HERE}
# Comma-separated ESPN league IDs
ESPN_LEAGUE_IDS=12345678
# Optional ESPN team ID (if omitted, automatically inferred from SWID)
ESPN_TEAM_ID=

# ===================================================
# Sleeper Configuration
# ===================================================
# Sleeper username or numerical user_id
SLEEPER_USER_ID=your_sleeper_username
# Sleeper session token (required for lineup write/swap mutations)
SLEEPER_TOKEN=your_sleeper_session_token_here
# Optional comma-separated Sleeper league IDs (if omitted, auto-discovered for user)
SLEEPER_LEAGUE_IDS=123456789012345678,234567890123456789

# ===================================================
# Notification Configuration (Email SMTP)
# ===================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL_TO=your_email@gmail.com
NOTIFICATION_EMAIL_FROM=your_email@gmail.com

# ===================================================
# Runtime Options
# ===================================================
DRY_RUN=false
SEASON_YEAR=2024
LOG_LEVEL=INFO
FORCE_EMAIL=false
