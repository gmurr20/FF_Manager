# ===================================================
# ESPN Configuration
# ===================================================
# ESPN cookie credentials
ESPN_S2=your_espn_s2_cookie_here
ESPN_SWID={YOUR-SWID-COOKIE-HERE}
# Comma-separated ESPN league IDs
ESPN_LEAGUE_IDS=12345678
# Optional ESPN team ID (if omitted, automatically inferred from SWID)
ESPN_TEAM_ID=

# ===================================================
# Sleeper Configuration
# ===================================================
# Sleeper username or numerical user_id
SLEEPER_USER_ID=your_sleeper_username
# Sleeper session token (required for lineup write/swap mutations)
SLEEPER_TOKEN=your_sleeper_session_token_here
# Optional comma-separated Sleeper league IDs (if omitted, auto-discovered for user)
SLEEPER_LEAGUE_IDS=123456789012345678,234567890123456789

# ===================================================
# Notification Configuration (Resend HTTP API)
# ===================================================
# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY=re_123456789_abcdefg
# Destination email address for lineup alerts and summaries
NOTIFICATION_EMAIL_TO=your_email@gmail.com
# Sender email address (e.g. 'onboarding@resend.dev' or your verified custom domain)
NOTIFICATION_EMAIL_FROM=onboarding@resend.dev

# ===================================================
# Database (Notification Deduplication)
# ===================================================
# Postgres URL — enables dedup so repeat alerts for the same issue are suppressed.
# If not set, deduplication is disabled and emails send on every run.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Unique ID for this user/deployment (default: "default")
NOTIFICATION_USER_ID=default

# ===================================================
# Runtime Options
# ===================================================
DRY_RUN=false
SEASON_YEAR=2024
LOG_LEVEL=INFO
FORCE_EMAIL=false
